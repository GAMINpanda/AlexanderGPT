# Share the harness by allowlist. Local files stay private unless added deliberately.
/*
!/.gitignore
!/AGENTS.md
!/CODEX.md
!/README.md
!/.local-ai/

/.local-ai/*
!/.local-ai/HARNESS.md
!/.local-ai/benchmark-baseline.zip
!/.local-ai/benchmark-results.json
!/.local-ai/benchmark_harness.py
!/.local-ai/chat_memory.py
!/.local-ai/compact-chat.html
!/.local-ai/compact-chat.py
!/.local-ai/file-sharing.js
!/.local-ai/harness_context.py
!/.local-ai/local_files.py
!/.local-ai/reply-markdown.js
!/.local-ai/start-aider.cmd
!/.local-ai/start-chat.cmd
!/.local-ai/test_harness.py
!/.local-ai/searxng/
!/.local-ai/vendor/

/.local-ai/searxng/*
!/.local-ai/searxng/compose.yaml
!/.local-ai/searxng/config/
/.local-ai/searxng/config/*
!/.local-ai/searxng/config/settings.yml

/.local-ai/vendor/*
!/.local-ai/vendor/katex/
!/.local-ai/vendor/markdown-it/
/.local-ai/vendor/katex/*
!/.local-ai/vendor/katex/LICENSE
!/.local-ai/vendor/katex/*.min.js
!/.local-ai/vendor/katex/katex.min.css
!/.local-ai/vendor/katex/fonts/
/.local-ai/vendor/katex/fonts/*
!/.local-ai/vendor/katex/fonts/KaTeX_*.woff2
/.local-ai/vendor/markdown-it/*
!/.local-ai/vendor/markdown-it/LICENSE
!/.local-ai/vendor/markdown-it/VERSION
!/.local-ai/vendor/markdown-it/markdown-it.js
