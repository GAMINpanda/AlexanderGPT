# Share the harness by allowlist. Local files stay private unless added deliberately.
/*
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/CODEX.md
!/README.md
!/.local-ai/
!/server/
!/web/
!/tests/
!/benchmarks/
!/docs/

/server/*
!/server/compact_chat.py
!/server/chat_memory.py
!/server/harness_context.py
!/server/local_files.py
!/server/llama_runtime.py

/web/*
!/web/compact-chat.html
!/web/file-sharing.js
!/web/reply-markdown.js
!/web/vendor/

/tests/*
!/tests/test_harness.py

/benchmarks/*
!/benchmarks/benchmark-baseline.zip
!/benchmarks/benchmark-results.json
!/benchmarks/benchmark_harness.py

/docs/*
!/docs/HARNESS.md

/.local-ai/*
!/.local-ai/start-aider.cmd
!/.local-ai/start-chat.cmd
!/.local-ai/start-aider.sh
!/.local-ai/start-chat.sh
!/.local-ai/searxng/

/.local-ai/searxng/*
!/.local-ai/searxng/compose.yaml
!/.local-ai/searxng/config/
/.local-ai/searxng/config/*
!/.local-ai/searxng/config/settings.yml

/web/vendor/*
!/web/vendor/katex/
!/web/vendor/markdown-it/
/web/vendor/katex/*
!/web/vendor/katex/LICENSE
!/web/vendor/katex/auto-render.min.js
!/web/vendor/katex/katex.min.js
!/web/vendor/katex/katex.min.css
!/web/vendor/katex/fonts/
/web/vendor/katex/fonts/*
!/web/vendor/katex/fonts/KaTeX_*.woff2
/web/vendor/markdown-it/*
!/web/vendor/markdown-it/LICENSE
!/web/vendor/markdown-it/VERSION
!/web/vendor/markdown-it/markdown-it.js
